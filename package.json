  "license": "Apache-2.0",
  "author": "Sailalith Sarupuri",
  "homepage": "https://github.com/sarupurisailalith/Halcyon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarupurisailalith/Halcyon.git"
  },
  "bugs": {
    "url": "https://github.com/sarupurisailalith/Halcyon/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "build": "pnpm -r run build && pnpm --filter halcyon run bundle-web",
    "typecheck": "tsc -b packages/server && pnpm --filter web run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node packages/server/dist/cli.js",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
