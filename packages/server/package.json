{
  "name": "halcyon-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first canvas for your AI coding CLI sessions",
  "license": "Apache-2.0",
  "author": "Sailalith Sarupuri",
  "homepage": "https://github.com/sarupurisailalith/Halcyon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarupurisailalith/Halcyon.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/sarupurisailalith/Halcyon/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "coding-agents",
    "sessions",
    "canvas",
    "local-first",
    "cli"
  ],
  "type": "module",
  "bin": {
    "halcyon": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "build": "tsc -b",
    "bundle-web": "node scripts/bundle-web.mjs",
    "dev": "node --watch dist/cli.js --no-open --fixtures",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@halcyon/core": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
